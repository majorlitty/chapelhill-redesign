# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending consultation and inquiry emails via Resend.
# Add your live key inside .env.local for local development or production secrets.
RESEND_API_KEY="re_your_resend_api_key_here"

# RESEND_FROM_EMAIL: Verified sender address from resend.com/domains.
# Without a verified domain, defaults to onboarding@resend.dev (sandbox mode).
RESEND_FROM_EMAIL="Chapelhill Advisory <onboarding@resend.dev>"

# RESEND_TO_EMAIL: Destination inbox for website inquiries.
RESEND_TO_EMAIL="chapelhillmulticompanyltd@gmail.com"
